{
  "name": "editor",
  "version": "0.5.0",
  "description": "Headless transactional editor for LLMs (MCP). P0–P4: read, search, atomic batch edit, transactions with backups, undo/redo via snapshots, auto-rollback.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "editor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}